---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Dartpollo generator documentation' } = Astro.props.frontmatter ?? Astro.props;
const base = import.meta.env.BASE_URL;
const relativePath = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) : Astro.url.pathname;
const path = relativePath || '/';
const groups = [
  {
    label: 'Introduction',
    links: [
      ['/', 'Overview'],
      ['/getting-started/', 'Getting started'],
      ['/integration-modes/', 'Integration modes'],
    ],
  },
  {
    label: 'Generator',
    links: [
      ['/configuration/', 'Configuration'],
      ['/generated-output/', 'Generated output'],
      ['/graphql-features/', 'GraphQL features'],
    ],
  },
  {
    label: 'Optional client',
    links: [
      ['/dartpollo-client/', 'Dartpollo client'],
      ['/caching/', 'Caching'],
    ],
  },
  {
    label: 'Learn',
    links: [
      ['/examples/', 'Examples'],
      ['/troubleshooting/', 'Troubleshooting'],
    ],
  },
];

const hrefFor = (href: string) => href === '/' ? `${base}/` : `${base}${href}`;
const active = (href: string) => href === '/' ? path === '/' || path === '' : path === href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title} | Dartpollo</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="topbar">
      <a class="brand" href={`${base}/`} aria-label="Dartpollo documentation home">
        <img src={`${base}/favicon.svg`} alt="" />
        <span>Dartpollo</span>
        <code>0.1.0-alpha.7</code>
      </a>
      <nav aria-label="External links">
        <a href="https://pub.dev/packages/dartpollo_generator">pub.dev</a>
        <a href="https://github.com/dwikyhardi/dartpollo">GitHub</a>
      </nav>
    </header>

    <details class="mobile-nav">
      <summary>Documentation</summary>
      <nav aria-label="Mobile documentation navigation">
        {groups.flatMap((group) => group.links).map(([href, label]) => (
          <a href={hrefFor(href)} aria-current={active(href) ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
    </details>

    <div class="docs-grid">
      <aside class="sidebar" aria-label="Documentation navigation">
        {groups.map((group) => (
          <section>
            <h2>{group.label}</h2>
            <nav>
              {group.links.map(([href, label]) => (
                <a href={hrefFor(href)} aria-current={active(href) ? 'page' : undefined}>{label}</a>
              ))}
            </nav>
          </section>
        ))}
      </aside>

      <main id="content" class="prose">
        <slot />
      </main>
    </div>

    <footer>
      <span>Dartpollo · MIT License</span>
      <a href="https://github.com/dwikyhardi/dartpollo/issues">Report a documentation issue</a>
    </footer>
  </body>
</html>
